{
  "name": "tools",
  "version": "0.1.0",
  "description": "A collection of online tools that prioritize frontend execution for performance and privacy",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "dev:start": "./scripts/dev-start.sh",
    "dev:stop": "./scripts/dev-stop.sh",
    "dev:logs": "./scripts/dev-logs.sh",
    "dev:status": "./scripts/dev-status.sh",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "npm run lint:biome && npm run lint:eslint && npm run lint:types",
    "lint:biome": "biome check",
    "lint:eslint": "eslint . --ext .ts,.tsx,.js,.jsx -c eslint.config.mjs",
    "lint:types": "tsc --noEmit",
    "lint:fix": "npm run lint:biome:fix && npm run lint:eslint:fix",
    "lint:biome:fix": "biome check --write",
    "lint:eslint:fix": "eslint . --ext .ts,.tsx,.js,.jsx -c eslint.config.mjs --fix",
    "format": "biome format --write",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pre-commit": "npm run lint && npm run test",
    "ci-check": "npm run lint && npm run test && npm run build",
    "prepare": "husky",
    "docker:build": "docker build -t tools-app .",
    "docker:build:dev": "docker build -f Dockerfile.dev -t tools-app:dev .",
    "docker:run": "docker run -p 3000:3000 tools-app",
    "docker:run:dev": "docker run -p 3000:3000 -v $(pwd):/app -v /app/node_modules tools-app:dev",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:compose:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:compose:prod": "docker-compose up -d",
    "docker:compose:nginx": "docker-compose --profile with-nginx up -d",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker system prune -f && docker volume prune -f"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^6.1.6",
    "@mui/lab": "^6.0.0-beta.15",
    "@mui/material": "^6.1.6",
    "@types/jszip": "^3.4.0",
    "jszip": "^3.10.1",
    "next": "15.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-no-storage": "^1.0.2",
    "eslint-plugin-prefer-arrow-functions": "^3.6.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^7.7.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "lint-staged": "^16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
