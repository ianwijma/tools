## File Processing Patterns

### File Upload Pattern
```typescript
const handleFileUpload = (event: React.ChangeEvent<HTMLInputElement>) => {
  const file = event.target.files?.[0];
  if (!file) return;

  // Validate file type and size
  if (!isValidFileType(file)) {
    setError('Invalid file type');
    return;
  }

  if (file.size > MAX_FILE_SIZE) {
    setError('File too large');
    return;
  }

  setInputFile(file);
};
```

### File Processing Pattern
```typescript
const processFile = async (file: File) => {
  setIsLoading(true);
  
  try {
    // Read file content
    const content = await readFileContent(file);
    
    // Process content
    const result = ToolName.process({ content, options });
    
    if ('message' in result) {
      setError(result.message);
    } else {
      setOutput(result.processedContent);
    }
  } catch (error) {
    setError('File processing failed');
  } finally {
    setIsLoading(false);
  }
};
```

## Validation Patterns

### Input Validation
```typescript
const validateInput = (input: ToolInput): string[] => {
  const errors: string[] = [];

  if (!input.text && input.text !== '') {
    errors.push('Text input is required');
  }

  if (input.options.size < 0 || input.options.size > 1000) {
    errors.push('Size must be between 0 and 1000');
  }

  return errors;
};
```

### File Validation
```typescript
const validateFile = (file: File): string[] => {
  const errors: string[] = [];

  if (!ALLOWED_FILE_TYPES.includes(file.type)) {
    errors.push(`File type ${file.type} is not supported`);
  }

  if (file.size > MAX_FILE_SIZE) {
    errors.push(`File size ${file.size} exceeds maximum ${MAX_FILE_SIZE}`);
  }

  return errors;
};
```

