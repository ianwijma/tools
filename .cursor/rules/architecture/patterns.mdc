# Architecture Patterns

## Tool Development Pattern

### 1. Tool Logic Structure
```typescript
// src/lib/[tool-name].ts
export interface ToolInput {
  // Define input parameters for ONE specific task
}

export interface ToolOutput {
  // Define output structure for ONE specific result
}

export interface ToolError {
  message: string;
  code: string;
  details?: any;
}

export class ToolName {
  static process(input: ToolInput): ToolOutput | ToolError {
    try {
      // Validate input first
      const errors = this.validate(input);
      if (errors.length > 0) {
        return { message: errors.join(', '), code: 'VALIDATION_ERROR' };
      }

      // Process with frontend logic
      const result = this.performProcessing(input);
      
      return result;
    } catch (error) {
      return { 
        message: 'Processing failed', 
        code: 'PROCESSING_ERROR',
        details: error instanceof Error ? error.message : 'Unknown error'
      };
    }
  }

  static validate(input: ToolInput): string[] {
    const errors: string[] = [];
    // Validation logic here
    return errors;
  }

  private static performProcessing(input: ToolInput): ToolOutput {
    // Core processing logic here
  }
}
```

### 2. Component Structure
```typescript
// src/components/tools/[ToolName]Tool.tsx
'use client';

import { useState } from 'react';
import { ToolName } from '@/lib/tool-name';
import { ToolInput } from '@/types/tool-name';

export function ToolNameTool() {
  const [input, setInput] = useState<ToolInput>({});
  const [output, setOutput] = useState<string>('');
  const [error, setError] = useState<string>('');
  const [isLoading, setIsLoading] = useState<boolean>(false);

  const handleProcess = async () => {
    setIsLoading(true);
    setError('');
    
    try {
      const result = ToolName.process(input);
      
      if ('message' in result) {
        setError(result.message);
        setOutput('');
      } else {
        setOutput(result.output);
        setError('');
      }
    } catch (error) {
      setError('An unexpected error occurred');
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div className="tool-container">
      {/* Tool UI with proper loading states and error handling */}
    </div>
  );
}
```

